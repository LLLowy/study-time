# ============================================================
#  你自己的学习数据 —— 绝对不要上传
#  任务、灵感、笔记、自动备份都在这里，是私人内容
# ============================================================
data/*
!data/.gitkeep

# 整份快照备份（存在 data 外面，防止 data 被误删时一起没掉）
backups/

# 临时文件
_shots/
_testrun/
*.tmp
*.log
*.broken-*

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# 本项目零依赖，留着以防万一
node_modules/
package-lock.json
