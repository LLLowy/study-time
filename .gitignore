# ============================================================
#  这个仓库只放程序代码。
#  你的学习数据默认存在「文档\学习工作站数据」，不在仓库里，
#  所以替换、重装、甚至删掉整个项目文件夹都不影响你的记录。
# ============================================================

# 万一用 --data 把数据指回了程序目录里，也别上传
data/*
!data/.gitkeep
backups/

# 运行时文件（端口号、停止令牌）
.runtime/

# 临时文件
_shots/
_testrun/
*.tmp
*.log
*.broken-*

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# 本项目零依赖，留着以防万一
node_modules/
package-lock.json
